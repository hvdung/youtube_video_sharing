FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CABLE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CABLE_URL=$NEXT_PUBLIC_CABLE_URL

RUN npm run build

EXPOSE 4000

CMD ["npm", "run", "start"]
